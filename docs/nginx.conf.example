# BAB GEO — Nginx reverse proxy (production, domain root)
# Copy to your server and adjust ssl_certificate paths.
#
# Prerequisites:
#   - Frontend built with NEXT_PUBLIC_BASE_PATH= (empty)
#   - Docker frontend listening on 127.0.0.1:3003
#   - Backend API on 127.0.0.1:4001 (or proxy /api separately)

server {
    listen 443 ssl http2;
    server_name bab.com.sa;

    # ssl_certificate     /etc/letsencrypt/live/bab.com.sa/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/bab.com.sa/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name bab.com.sa;
    return 301 https://$host$request_uri;
}
