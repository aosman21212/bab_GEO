# Docker / server .env — copy next to docker-compose.yml; never commit real secrets
SITE_URL=https://bab.com.sa
NEXT_PUBLIC_SITE_URL=https://bab.com.sa
CORS_ORIGIN=https://bab.com.sa
INDEXNOW_KEY=
BING_SITE_AUTH_CODE=
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
GA_LEAD_CURRENCY=SAR
GA_LEAD_VALUE=1

# Required for backend (Docker sets NODE_ENV=production — weak defaults are rejected)
# JWT_SECRET: 24+ random characters
# ADMIN_PASSWORD: 12+ characters (do not use Admin123! in production)
JWT_SECRET=
ADMIN_EMAIL=admin@bab.com.sa
ADMIN_PASSWORD=

# Contact Us inquiry notifications (backend / docker-compose)
INQUIRY_NOTIFY_TO=sales@bab.com.sa
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@bab.com.sa
SMTP_PASS=
SMTP_FROM=BAB Sales <sales@bab.com.sa>
