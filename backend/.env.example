PORT=4001
# Local host apps (mongo mapped to 27018):
MONGODB_URI=mongodb://127.0.0.1:27018/bab_cms
REDIS_URL=redis://127.0.0.1:6379
# Docker Compose services use:
# MONGODB_URI=mongodb://mongo:27017/bab_cms
# REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-in-production-bab-cms
CORS_ORIGIN=http://localhost:3003
ADMIN_EMAIL=admin@bab.com.sa
ADMIN_PASSWORD=Admin123!

# Contact Us inquiry notifications (defaults to sales@bab.com.sa)
INQUIRY_NOTIFY_TO=sales@bab.com.sa
# Optional SMTP — if SMTP_HOST is empty, inquiries still save but no email is sent
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bab.com.sa
