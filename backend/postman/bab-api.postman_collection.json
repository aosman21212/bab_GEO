    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Mint dev token (bypass MFA)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "description": "Signs an `mfaVerified` JWT locally with {{jwtSecret}} and stores it in {{token}}, skipping the email code. Calls GET /api/users to prove the token works and to capture a real user _id into {{adminUserId}} (needed by GET /api/auth/me, which looks the id up in Mongo).\n\nFails with 401 if {{jwtSecret}} does not match the server's JWT_SECRET."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Postman predefines CryptoJS as a sandbox global; do not redeclare it.",
                  "function b64url(input) {",
                  "  const words = typeof input === 'string' ? CryptoJS.enc.Utf8.parse(input) : input;",
                  "  return CryptoJS.enc.Base64.stringify(words)",
                  "    .replace(/=+$/, '')",
                  "    .replace(/\\+/g, '-')",
                  "    .replace(/\\//g, '_');",
                  "}",
                  "",
                  "// pm.variables resolves environment, collection and global scopes.",
                  "const secret = pm.variables.get('jwtSecret');",
                  "if (!secret) { throw new Error('Set the jwtSecret variable to the server JWT_SECRET'); }",
                  "",
                  "const now = Math.floor(Date.now() / 1000);",
                  "const header = b64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
                  "const payload = b64url(JSON.stringify({",
                  "  sub: pm.variables.get('adminUserId') || '000000000000000000000000',",
                  "  email: pm.variables.get('adminEmail'),",
                  "  role: 'admin',",
                  "  sid: 'postman-' + now,",
                  "  mfaVerified: true,",
                  "  iat: now,",
                  "  exp: now + 20 * 60",
                  "}));",
                  "const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, secret));",
                  "",
                  "pm.collectionVariables.set('token', header + '.' + payload + '.' + signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('minted token is accepted', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const users = pm.response.json();",
                  "  if (Array.isArray(users) && users.length) {",
                  "    const match = users.find((u) => u.email === pm.variables.get('adminEmail')) || users[0];",
                  "    pm.collectionVariables.set('adminUserId', match._id);",
                  "",
                  "    // Re-mint bound to a real _id, otherwise GET /api/auth/me cannot resolve the user.",
                  "    const b64url = (input) => CryptoJS.enc.Base64",
                  "      .stringify(typeof input === 'string' ? CryptoJS.enc.Utf8.parse(input) : input)",
                  "      .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "",
                  "    const now = Math.floor(Date.now() / 1000);",
                  "    const header = b64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
                  "    const payload = b64url(JSON.stringify({",
                  "      sub: match._id,",
                  "      email: match.email,",
                  "      role: match.role || 'admin',",
                  "      sid: 'postman-' + now,",
                  "      mfaVerified: true,",
                  "      iat: now,",
                  "      exp: now + 20 * 60",
                  "    }));",
                  "    const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, pm.variables.get('jwtSecret')));",
                  "    pm.collectionVariables.set('token', header + '.' + payload + '.' + signature);",
                  "    console.log('token bound to ' + match.email + ' (' + match._id + ')');",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"locale\": \"en\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Step 1 of 2. Validates credentials, stores an MFA challenge and emails a 6-digit code. Returns `mfaRequired: true` plus a 10-minute `mfaToken` — not a session token.\n\nRate limited to 10 attempts per minute per IP and per email.\n\nReturns 503 if SMTP is not configured, since the code cannot be delivered."
            },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('MFA is required', () => pm.expect(body.mfaRequired).to.be.true);",
                  "  pm.collectionVariables.set('mfaToken', body.mfaToken);",
                  "  console.log('Check ' + body.email + ' for the 6-digit code, put it in the mfaCode variable, then run \"2. Verify MFA code\".');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Verify MFA code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"code\": \"{{mfaCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/mfa/verify",
            "description": "Step 2 of 2. Exchanges the emailed code for a 20-minute session JWT and stores it in {{token}}.\n\nFive wrong attempts lock the challenge (429) and you must start again at Login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('session token returned', () => pm.expect(body.token).to.be.a('string'));",
                  "  pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend MFA code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"mfaToken\": \"{{mfaToken}}\",\n  \"locale\": \"en\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/mfa/resend",
            "description": "Issues a fresh code for the existing challenge. Subject to a 60-second cooldown, which returns 429 with `secondsRemaining`."
          }
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Current admin. Resolves {{token}}'s `sub` against Mongo, so a minted token needs {{adminUserId}} to be a real user _id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (expect 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"definitely-not-the-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Negative check. A 503 here instead of 401 means the API could not be reached or SMTP failed, not that the credentials were wrong."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
