    {
      "name": "Session teardown",
      "description": "Kept last on purpose. Logout denylists the session id in Redis, so running it earlier would 401 every request that follows it in a collection run.",
      "item": [
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Denylists the current session id for the remainder of its 20-minute lifetime, then clears {{token}}. Accepts expired tokens.\n\n{{token}} is dead afterwards — mint or log in again before running anything else."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "// The sid is denylisted now, so do not leave a dead token behind.",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ]
        }
      ]
    }
