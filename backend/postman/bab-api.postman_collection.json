            },
            "url": "{{baseUrl}}/api/users",
            "description": "Creates an admin. Password minimum 8 characters, duplicate email returns 409. The email is timestamped so repeat runs never collide, and the new _id is stored in {{userId}} for the PATCH and DELETE below.\n\n{{userId}} is only ever set from a successful create here, so the DELETE cannot target a pre-existing admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('userId', pm.response.json()._id);",
                  "} else {",
                  "  // Never leave a stale id behind - the DELETE below would target a real admin.",
                  "  pm.collectionVariables.set('userId', '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/users/:id",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"password\": \"RotatedPass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "description": "Updates email and/or password. Sending neither returns 400."
          }
        },
