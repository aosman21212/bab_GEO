{
  "name": "bab-monorepo",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:web": "npm run dev --prefix frontend",
    "dev:server": "npm run dev --prefix backend",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "seo:submit-indexnow": "npm run seo:submit-indexnow --prefix frontend",
    "seo:rotate-indexnow-key": "npm run seo:rotate-indexnow-key --prefix frontend",
    "docker:up": "docker compose up -d --build frontend backend",
    "docker:rebuild": "docker compose up -d --build frontend backend",
    "docker:down": "docker compose down",
    "docker:seed": "docker compose --profile seed run --rm seed",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
